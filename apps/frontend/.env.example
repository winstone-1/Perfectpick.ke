# Frontend env — copy to .env (never commit .env)
VITE_API_URL=http://localhost:3000/api
# Google Sign-In (optional — email/password always works).
# If ANY of these is missing/invalid, the Google button is gracefully
# disabled with a friendly notice instead of failing after a popup.
# Get values from: Firebase Console → Project Settings → General.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
